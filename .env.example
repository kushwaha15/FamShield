NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres:replace-with-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DB_POOL_MAX=10
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TOKEN_PEPPER=replace-with-an-independent-random-secret-at-least-32-characters
AUTH_DEV_OTP_EXPOSE=true
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10
SMS_PROVIDER=development
EMAIL_PROVIDER=development
# Optional production provider examples:
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://sms-provider.example/send
# SMS_HTTP_API_KEY=provide-through-secret-manager
# EMAIL_PROVIDER=http
# EMAIL_HTTP_URL=https://email-provider.example/send
# EMAIL_HTTP_API_KEY=provide-through-secret-manager
